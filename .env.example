# Google Cloud / Firebase
# Local dev: point to a service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# Railway / Cloud Run: base64-encoded service account JSON (alternative to the file above)
# GOOGLE_APPLICATION_CREDENTIALS_JSON=<base64-encoded service-account.json>

# API server  (Railway injects PORT automatically — no need to set it there)
PORT=8000

# CORS — comma-separated list of allowed frontend origins
# Railway: set this to your frontend Railway URL, e.g. https://70sl-frontend.up.railway.app
CORS_ORIGINS=http://localhost:3000

# Frontend
# Railway: set this to your API Railway URL, e.g. https://70sl-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Local development with Firebase Emulator Suite ---
# Uncomment these when running `firebase emulators:start`
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
